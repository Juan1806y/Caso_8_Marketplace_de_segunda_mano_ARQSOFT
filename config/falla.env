# Escenario QA-3 con la falla:
# - el proveedor de notificaciones no está disponible durante 20 s (responde 503)
# - el broker pierde 1 de cada 10 confirmaciones, como cuando el notificador
#   se reinicia antes de confirmar (acto 4 del laboratorio), y vuelve a entregar a los 1000 ms
PROVEEDOR_CAIDO_MS=20000
CONFIRMACION_PERDIDA_CADA=10
REENTREGA_MS=1000
